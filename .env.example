# 법제처 API
BUPGOGAE_API_KEY=your_api_key_here

# GitHub Actions repository variable (secret이 아님).
# 권한 있는 관리자가 Cloudflare Application Terms를 검토·승인한 뒤에만 true.
CLOUDFLARE_WARP_TOS_ACCEPTED=false

# Cloudflare R2
AWS_ACCESS_KEY_ID=your_r2_access_key
AWS_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=your_bucket_name
# State 전용 버킷: 사용자 도메인과 r2.dev 공개 접근을 모두 끈 별도 버킷.
# 기존 공개 버킷에서 검증된 state를 이관한 뒤 설정한다. 자동 fallback 없음.
R2_STATE_BUCKET=your_private_state_bucket
CF_ACCOUNT_ID=your_cloudflare_account_id

# Telegram (선택 — crawler 리포트)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
