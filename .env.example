# 법제처 API
BUPGOGAE_API_KEY=your_api_key_here

# GitHub Actions WARP step 전용 WireGuard private key
# 로컬 crawler에는 필요하지 않으며 저장소에 실제 값을 커밋하지 않는다.
WARP_PRIVATE_KEY=your_wireguard_private_key

# Cloudflare R2
AWS_ACCESS_KEY_ID=your_r2_access_key
AWS_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=your_bucket_name
CF_ACCOUNT_ID=your_cloudflare_account_id

# Telegram (선택 — crawler 리포트)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
