#!/bin/sh
#
# 법고개(Bupgogae) — 로컬 pre-push gate
# 전체 Playwright E2E는 push 전 수동 검증과 원격 CI가 담당한다.

set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ -x "$REPO_ROOT/.venv/Scripts/python.exe" ]; then
  PYTHON="$REPO_ROOT/.venv/Scripts/python.exe"
elif [ -x "$REPO_ROOT/.venv/bin/python" ]; then
  PYTHON="$REPO_ROOT/.venv/bin/python"
else
  PYTHON="${PYTHON:-python}"
fi

FAILED=0

echo "🔒 [1/5] 확장 보안 금칙어·평문 WARP key 검사"
FORBIDDEN_PATTERNS='innerHTML\s*=|outerHTML\s*=|eval\s*\(|new\s+Function\s*\(|document\.write\s*\(|\.insertAdjacentHTML\s*\('
MATCHES="$(
  grep -rnE "$FORBIDDEN_PATTERNS" \
    "$REPO_ROOT/extension/background/"*.js \
    "$REPO_ROOT/extension/content/"*.js \
    "$REPO_ROOT/extension/popup/"*.js \
    2>/dev/null |
    grep -v '\.test\.js' |
    grep -v '// safe:' || true
)"
if [ -n "$MATCHES" ]; then
  echo "$MATCHES"
  FAILED=1
fi
if grep -Eq 'PrivateKey[[:space:]]*=[[:space:]]*[A-Za-z0-9+/]{43}=' \
  "$REPO_ROOT/.github/scripts/connect-warp.sh"; then
  echo "평문 WireGuard private key가 connect-warp.sh에 있습니다."
  FAILED=1
fi

echo "🧹 [2/5] JavaScript lint"
if ! npm run lint:js; then
  FAILED=1
fi

echo "🧪 [3/5] Jest"
if ! npm test -- --runInBand; then
  FAILED=1
fi

echo "🐍 [4/5] Python lint + unittest"
if ! "$PYTHON" -m ruff check --no-cache pipeline scripts; then
  FAILED=1
fi
if ! "$PYTHON" -m unittest discover -s pipeline -p "test_*.py" -v; then
  FAILED=1
fi

echo "📦 [5/5] 0.9.0 release bundle 검증"
if ! "$PYTHON" scripts/package.py; then
  FAILED=1
fi

if [ "$FAILED" -ne 0 ]; then
  echo "❌ pre-push gate 실패"
  exit 1
fi

echo "✅ pre-push gate 통과 (Playwright E2E는 CI에서도 재검증)"
