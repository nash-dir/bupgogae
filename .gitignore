# ===== Docker (크롤러 인프라 경로 포함) =====
docker-compose*.yml
Dockerfile*
# 예외 설정: 공용으로 공유해야 하는 크롤러 설정은 추적 허용
!Dockerfile.crawler
!docker-compose.crawler.yml

# ===== 개발 환경 =====
venv/
__pycache__/
.env
.env.*
# 예외 설정: 환경변수 템플릿 파일은 추적 허용
!.env.example
.DS_Store
Thumbs.db
desktop.ini
*.pyc
*.pyo
*.pyd

# ===== IDE & Editors =====
.vscode/
.idea/
*.swp
*.swo

# ===== Node =====
node_modules/

# ===== 스크랩/실험 (전체 제외) =====
scrap/
tmp/

# ===== 레거시 코드 =====
legacy/

# ===== Backfill 출력 =====
backfill/
caseDB_*
pipeline/output/

# ===== 내부 문서/리포트 =====
report/

