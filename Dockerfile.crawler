FROM python:3.12.13-slim-trixie@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

WORKDIR /app

# 검토된 Linux wheel만 해시 검증하여 설치 (캐시 레이어)
COPY requirements-crawler.lock .
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: \
    -r requirements-crawler.lock

# 소스 복사
COPY pipeline/ ./pipeline/

# 볼륨: 체크포인트 / 출력 영속
VOLUME /app/data

ENV PYTHONUNBUFFERED=1
ENV TZ=Asia/Seoul

ENTRYPOINT ["python", "/app/pipeline/crawler_runner.py", "--data-dir", "/app/data"]
