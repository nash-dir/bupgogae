{
  "version": "2026-10-18",
  "hosts": {
    "gemini.google.com": "gemini",
    "chatgpt.com": "chatgpt",
    "claude.ai": "claude",
    "copilot.microsoft.com": "copilot",
    "copilot.com": "copilot",
    "copilot.cloud.microsoft": "copilot",
    "www.perplexity.ai": "perplexity",
    "perplexity.ai": "perplexity",
    "grok.com": "grok"
  },
  "adapters": {
    "gemini": {
      "responseSelectors": [
        "message-content",
        ".model-response-text",
        ".markdown-main-panel",
        "model-response",
        ".response-container",
        "chat-response",
        "[class*=\"message-content\"]",
        "[class*=\"model-response\"]"
      ]
    },
    "chatgpt": {
      "responseSelectors": [
        "[data-message-role=\"assistant\"]",
        "[data-chatgpt-search-unit-key$=\":assistant\"]",
        "div[data-message-author-role=\"assistant\"] .markdown",
        "div[data-message-author-role=\"assistant\"]",
        ".markdown.prose"
      ],
      "streamingIndicator": "[data-message-role=\"assistant\"]:not([data-message-complete]), .result-streaming"
    },
    "claude": {
      "responseSelectors": [
        "[data-testid=\"chat-message-content\"]",
        ".font-claude-message",
        "[data-testid=\"conversation-turn\"] .prose",
        "div.prose",
        "[class*=\"font-claude\"]",
        "[class*=\"message-content\"]",
        "[class*=\"prose\"]"
      ]
    },
    "copilot": {
      "responseSelectors": [
        "[role=\"article\"][aria-labelledby^=\"copilot-message-\"]",
        "[class*=\"group/assistant\"]",
        "[class*=\"prose\"]",
        "[class*=\"whitespace-pre-wrap\"]",
        "[class*=\"space-y-\"] > div.relative"
      ]
    },
    "perplexity": {
      "responseSelectors": [
        ".prose",
        ".prose:last-of-type"
      ]
    },
    "grok": {
      "responseSelectors": [
        ".markdown",
        ".prose",
        "[class*=\"message\"] [class*=\"content\"]",
        "[class*=\"response\"]"
      ]
    }
  },
  "scraping_adapters": {
    "law_go_kr": {
      "title_selector": "#contentBody > h2",
      "body_container": "#conScroll",
      "section_title": "h4",
      "section_body": "p.pty4, p.pty4_dep1, h5, div.subtit1"
    }
  }
}
