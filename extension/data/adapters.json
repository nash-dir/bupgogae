{
  "version": "2026-04-21",
  "adapters": {
    "gemini": {
      "responseSelectors": [
        "message-content",
        ".model-response-text",
        ".markdown-main-panel",
        "model-response",
        ".response-container"
      ]
    },
    "chatgpt": {
      "responseSelectors": [
        "div[data-message-author-role=\"assistant\"] .markdown",
        "div[data-message-author-role=\"assistant\"]",
        ".markdown.prose"
      ],
      "streamingIndicator": ".result-streaming"
    },
    "claude": {
      "responseSelectors": [
        "[data-testid=\"chat-message-content\"]",
        ".font-claude-message",
        "[data-testid=\"conversation-turn\"] .prose",
        "div.prose"
      ]
    },
    "copilot": {
      "responseSelectors": [
        "[class*=\"group/assistant\"]",
        "[class*=\"prose\"]",
        "[class*=\"whitespace-pre-wrap\"]",
        "[class*=\"space-y-\"] > div.relative"
      ]
    },
    "perplexity": {
      "responseSelectors": [
        ".prose",
        ".prose:last-of-type"
      ]
    },
    "grok": {
      "responseSelectors": [
        ".markdown",
        ".prose",
        "[class*=\"message\"] [class*=\"content\"]",
        "[class*=\"response\"]"
      ]
    }
  },
  "scraping_adapters": {
    "law_go_kr": {
      "title_selector": "#contentBody > h2",
      "body_container": "#conScroll",
      "section_title": "h4",
      "section_body": "p.pty4, p.pty4_dep1, h5, div.subtit1"
    }
  }
}
