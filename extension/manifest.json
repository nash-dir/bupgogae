{
  "manifest_version": 3,
  "name": "법고개 (Bupgogae)",
  "version": "0.8.1",
  "description": "LLM 환각 판례를 실시간으로 탐지합니다",
  "permissions": ["alarms", "storage", "unlimitedStorage", "tabs"],
  "host_permissions": [
    "*://*.law.go.kr/*",
    "https://api.bup.live/*"
  ],
  "background": { "service_worker": "background/db-sync.js" },
  "content_scripts": [{
    "_comment_matches": "이 목록은 data/adapters.json의 hosts 필드와 반드시 동기화 필요 (manifest.json은 정적 파일이라 동적 생성 불가)",
    "matches": [
      "https://gemini.google.com/*",
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://copilot.microsoft.com/*",
      "https://www.perplexity.ai/*",
      "https://perplexity.ai/*",
      "https://grok.com/*"
    ],
    "js": [
      "content/adapters/base-adapter.js",
      "content/adapters/registry.js",
      "content/case-regex.js",
      "content/precedent-badge.js",
      "content/sidebar.js",
      "content/bupgogae-content.js"
    ],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "법고개 (Bupgogae)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "copy_orange_cases": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "DB 미확인 사건번호(주황색) 복사"
    }
  },
  "web_accessible_resources": [{
    "resources": ["data/bupgogae_meta.json", "data/db.json", "data/adapters.json"],
    "matches": [
      "https://gemini.google.com/*",
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://copilot.microsoft.com/*",
      "https://www.perplexity.ai/*",
      "https://perplexity.ai/*",
      "https://grok.com/*"
    ]
  }]
}
