{
  "name": "bupgogae-extension",
  "version": "0.9.0",
  "description": "Bupgogae Extension Tests",
  "scripts": {
    "lint": "npm run lint:js",
    "lint:js": "eslint extension e2e scripts/*.js jest.setup.js playwright.config.js eslint.config.js",
    "lint:python": "python -m ruff check pipeline",
    "test": "jest",
    "test:python": "python -m unittest discover -s pipeline -p \"test_*.py\" -v",
    "eval:extraction": "node scripts/evaluate-extraction.js",
    "bundle:meta": "python scripts/refresh_bundle_meta.py",
    "package": "python scripts/package.py",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/audit/"
    ],
    "roots": [
      "<rootDir>/extension"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/audit/",
      "<rootDir>/backfill/"
    ],
    "testMatch": [
      "<rootDir>/extension/**/*.test.js",
      "<rootDir>/extension/**/*.spec.js"
    ]
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "deepmerge": "4.1.1"
  }
}
